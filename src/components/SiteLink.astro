---
import type { HTMLAttributes } from 'astro/types';

import { getUrl } from '#astro-utils/url-utils';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'text' | 'primary' | 'secondary';
}

const { href, variant = 'text', class: className, ...attrs } = Astro.props;

const linkClass = variant === 'text' 
  ? className 
  : ['site-button', `site-button--${variant}`, className].filter(Boolean).join(' ');

// Anything with a scheme (https:, mailto:, tel:) or a protocol-relative host
// is not a path of this site, so it gets neither the base path nor a slash
const isExternal = /^(?:[a-z][a-z\d+.-]*:|\/\/)/i.test(href);

// getUrl() ends a page URL in a slash whether or not the href has one
const finalHref = isExternal ? href : getUrl(href);

const finalRel = (attrs.target === '_blank' && !attrs.rel) ? 'noopener noreferrer' : attrs.rel;
---

<a
  href={finalHref}
  rel={finalRel}
  class={linkClass}
  {...attrs}
>
  <slot />
</a>
