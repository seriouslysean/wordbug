---
import { BASE_PATH } from 'astro:env/client';
import type { CollectionPageSchema, DefinedTermSchema, WordSchemaData } from '#types';
import {
  STRUCTURED_DATA_TYPE,
  type StructuredDataType,
  getBreadcrumbSchema,
  getCollectionSchemaData,
  getWebsiteSchemaData,
  getWordSchemaData
} from '#astro-utils/schema-utils';
import { seoConfig } from '#astro-utils/seo-utils';
import { generateBreadcrumbs } from '#utils/breadcrumb-utils';
import { serializeJsonLd } from '#utils/text-utils';

interface Props {
  word?: WordSchemaData;
  structuredDataType?: StructuredDataType;
  itemCount?: number;
  errorPage?: boolean;
}

const { word, structuredDataType, itemCount, errorPage = false } = Astro.props;

const websiteSchema = getWebsiteSchemaData();

type SchemaType = DefinedTermSchema | CollectionPageSchema | ReturnType<typeof getBreadcrumbSchema>;
const schemas: SchemaType[] = [];

if (structuredDataType === STRUCTURED_DATA_TYPE.WORD_SINGLE && word) {
  const wordSchema = getWordSchemaData(word);
  if (wordSchema) {
    schemas.push(wordSchema);
  }
} else if (structuredDataType === STRUCTURED_DATA_TYPE.WORD_LIST) {
  const collectionSchema = getCollectionSchemaData(
    seoConfig.siteName,
    seoConfig.defaultDescription,
    itemCount ?? 0
  );
  schemas.push(collectionSchema);
}

// A breadcrumb trail ends at the page's own URL, which an error page lacks:
// it is served at whatever URL was not found
if (!errorPage) {
  const breadcrumbs = generateBreadcrumbs(Astro.url.pathname, BASE_PATH, word?.word);
  const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
  if (breadcrumbSchema) {
    schemas.push(breadcrumbSchema);
  }
}
---

<script type="application/ld+json" set:html={serializeJsonLd(websiteSchema)} is:inline></script>

{schemas.map(schema => (
  <script type="application/ld+json" set:html={serializeJsonLd(schema)} is:inline></script>
))}
