---
import WordDisplay from '#components/WordDisplay.astro';
import Layout from '#layouts/Layout.astro';
import { getPageMetadata } from '#astro-utils/page-metadata';
import { allWords } from '#astro-utils/word-data-utils';
import { t } from '#utils/i18n-utils';
import { BASE_PATHS } from '#constants/urls';
import { isBasePartOfSpeech } from '#constants/parts-of-speech';
import type { WordData } from '#types';

const { title, description, partOfSpeech } = getPageMetadata(BASE_PATHS.NOT_FOUND);
const wordsToShow = allWords.slice(0, 4);
const sectionTitle = wordsToShow.length > 0 ? t('error.recent_words') : '';
const definition = description.replace(/^\w+\.\s*/, '');
// Make a mock word for 404 we can pass to WordDisplay
const notFoundWord: WordData = {
  word: title,
  date: '',
  adapter: 'static',
  data: [partOfSpeech && isBasePartOfSpeech(partOfSpeech)
    ? { text: definition, partOfSpeech }
    : { text: definition }],
};
---
<Layout title={title} description={description} noindex>
  <WordDisplay
    currentWord={notFoundWord}
    wordsToShow={wordsToShow}
    sectionTitle={sectionTitle}
  />
</Layout>
