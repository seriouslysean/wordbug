---
import { getPageMetadata } from '#astro-utils/page-metadata';
import { STRUCTURED_DATA_TYPE } from '#astro-utils/schema-utils';
import { getHomepageWords, allWords } from '#astro-utils/word-data-utils';
import WordDisplay from '#components/WordDisplay.astro';
import Layout from '#layouts/Layout.astro';
import { t } from '#utils/i18n-utils';

const { currentWord, previousWords: wordsToShow } = getHomepageWords(allWords);

const sectionTitle = wordsToShow.length > 0 ? t('home.previous_words') : '';

const { title, description } = getPageMetadata(Astro.url.pathname);
---

<Layout word={currentWord} title={title} description={description} structuredDataType={STRUCTURED_DATA_TYPE.WORD_SINGLE}>
  <WordDisplay
    currentWord={currentWord}
    wordsToShow={wordsToShow}
    sectionTitle={sectionTitle}
  />
</Layout>
