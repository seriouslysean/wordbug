---
import DefinitionList from '#components/DefinitionList.astro';
import DescriptionText from '#components/DescriptionText.astro';
import StatsSection from '#components/StatsSection.astro';
import { getPageMetadata } from '#astro-utils/page-metadata';
import Heading from '#components/Heading.astro';
import Layout from '#layouts/Layout.astro';
import { partOfSpeechStats } from '#astro-utils/word-data-utils';
import { t, tp } from '#utils/i18n-utils';
import { getPartOfSpeechUrl, getWordsPartOfSpeechUrl } from '#astro-utils/url-utils';

// Each count is the number of words the linked browse page lists
const partOfSpeechItems = partOfSpeechStats.map(({ partOfSpeech, count }) => ({
  label: t(`parts_of_speech.${partOfSpeech}`),
  value: tp('common.words', count),
  href: getPartOfSpeechUrl(partOfSpeech),
}));

const { title, description } = getPageMetadata(Astro.url.pathname);
---
<Layout title={title} description={description}>
  <div class="parts-of-speech">
    <Heading text={title} />
    <DescriptionText text={description} />

    {partOfSpeechItems.length > 0 && (
      <StatsSection title={t('words.by_part_of_speech_heading')} href={getWordsPartOfSpeechUrl()}>
        <DefinitionList items={partOfSpeechItems} />
      </StatsSection>
    )}
  </div>
</Layout>

<style>
    .parts-of-speech {
        max-width: var(--content-width-medium);
        margin: 0 auto;
    }
</style>
