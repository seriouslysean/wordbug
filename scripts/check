#!/usr/bin/env bash
# Runs what CI runs; prints one line per step, the full output only for a
# failing step, and exits nonzero if any step failed. A missing tool fails.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
status=0
step() {
  local name=$1 out
  shift
  if out=$("$@" 2>&1); then
    echo "ok   $name"
  else
    echo "FAIL $name"
    echo "$out"
    status=1
  fi
}
if command -v actionlint >/dev/null; then
  step actionlint actionlint
else
  echo "FAIL actionlint: not installed (brew install actionlint)"
  status=1
fi
step lint npm run lint
step typecheck npm run typecheck
step test npm test
# A site tracks its own words under data/words; the engine tracks none. Set and
# empty, SOURCE_DIR selects data/words and wins over a .env value, as
# SENTRY_ENABLED does: this build must not report to Sentry.
if [[ -n "$(git ls-files -- 'data/words/*.json')" ]]; then
  step build env SOURCE_DIR= SENTRY_ENABLED=false npm run build
fi
step build-demo env SOURCE_DIR=demo npm run build
step e2e npm run test:e2e
exit $status
