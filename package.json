{
  "name": "occasional-wotd",
  "type": "module",
  "version": "3.31.0",
  "private": true,
  "description": "Template for creating an occasional word of the day site",
  "keywords": [
    "word-of-the-day",
    "vocabulary",
    "learning",
    "astro",
    "static-site",
    "template"
  ],
  "author": "Sean Kennedy <sean@codeserious.com>",
  "license": "MIT",
  "homepage": "https://github.com/seriouslysean/occasional-wotd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seriouslysean/occasional-wotd.git"
  },
  "bugs": {
    "url": "https://github.com/seriouslysean/occasional-wotd/issues"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "tool:add-word": "node tools/add-word.ts",
    "tool:generate-all-images": "node tools/generate-images.ts",
    "tool:generate-images": "node tools/generate-images.ts",
    "tool:local": "node --env-file-if-exists=.env",
    "tool:normalize-word-data": "node tools/normalize-word-data.ts",
    "tool:regenerate-all-words": "node tools/regenerate-all-words.ts",
    "tool:sync": "./tools/sync-upstream.sh",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "astro check && tsc -p tsconfig.tests.json --noEmit",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.3.8",
    "entities": "^8.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@playwright/test": "^1.64.0",
    "@sentry/astro": "^11.6.0",
    "@sentry/node": "^11.6.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "cmu-pronouncing-dictionary": "3.0.0",
    "js-yaml": "^5.4.3",
    "lefthook": "^2.2.1",
    "lightningcss": "^1.33.0",
    "opentype.js": "^2.0.0",
    "oxlint": "^1.87.0",
    "sharp": "^0.35.5",
    "subtlex-word-frequencies": "2.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wordpos": "^2.1.0"
  },
  "imports": {
    "#components/*": "./src/components/*",
    "#layouts/*": "./src/layouts/*",
    "#pages/*": "./src/pages/*",
    "#astro-utils/*": "./src/utils/*.ts",
    "#utils/*": "./utils/*.ts",
    "#types": "./types/index.ts",
    "#types/*": "./types/*.ts",
    "#constants/*": "./constants/*.ts",
    "#config/*": "./config/*.ts",
    "#adapters": "./adapters/index.ts",
    "#adapters/*": "./adapters/*.ts",
    "#data/*": "./data/*",
    "#styles/*": "./src/styles/*",
    "#assets/*": "./src/assets/*",
    "#tools/*": "./tools/*.ts",
    "#locales/*": "./locales/*",
    "#tests/*": "./tests/*"
  },
  "allowScripts": {
    "lefthook@2.2.1": true,
    "wordpos@2.1.0": true,
    "fsevents": false
  }
}
