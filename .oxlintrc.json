{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node", "vitest"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "curly": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-nested-ternary": "error",
    "no-inline-comments": "error",
    "no-map-spread": "off",
    "prefer-const": "error",
    "no-var": "error",
    "preserve-caught-error": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/prefer-dom-node-append": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/consistent-type-definitions": ["error", "interface"],
    "unicorn/prefer-string-replace-all": "warn",
    "unicorn/prefer-array-flat-map": "warn",
    "unicorn/prefer-object-from-entries": "warn",
    "import/no-cycle": "error",
    "import/first": "error",
    "import/no-duplicates": "error",
    "import/no-relative-parent-imports": "error",
    "no-restricted-imports": ["error", {
      "patterns": [{
        "regex": "^\\.(/|$)",
        "message": "Import through a # alias (package.json imports), not a relative path."
      }]
    }],
    "import/default": "off",
    "import/no-named-as-default-member": "off",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    "promise/catch-or-return": "error",
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    "vitest/require-mock-type-parameters": "off",
    "no-underscore-dangle": ["warn", {
      "allow": ["__VERSION__", "__RELEASE__", "__TIMESTAMP__", "__WORD_DATA_PATH__"]
    }]
  },
  "overrides": [
    {
      "files": ["astro.config.ts", "sentry.client.config.js", "sentry.server.config.js"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["adapters/**", "tools/**", "tests/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "node/no-process-env": "error"
      }
    },
    {
      "files": ["tests/**"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
