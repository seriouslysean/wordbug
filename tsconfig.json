{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./types"]
  },
  "exclude": [
    "coverage/**/*",
    "dist/**/*",
    "node_modules/**/*",
    "tests/**/*"
  ]
}
