        {
          "definition": "<span class=\"usage-label-sense\"></span> <a rel=\"mw:WikiLink\" href=\"/wiki/testa\" title=\"testa\">Testa</a>; <a rel=\"mw:WikiLink\" href=\"/wiki/seed_coat\" title=\"seed coat\">seed coat</a>."
