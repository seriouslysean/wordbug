      "partOfSpeech": "Noun",
      "language": "English",
      "definitions": [
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt6\" typeof=\"mw:Transclusion\"></span> A <a rel=\"mw:WikiLink\" href=\"/wiki/confection\" title=\"confection\">confection</a> of <a rel=\"mw:WikiLink\" href=\"/wiki/sugar\" title=\"sugar\">sugar</a> and <a rel=\"mw:WikiLink\" href=\"/wiki/corn_syrup\" title=\"corn syrup\">corn syrup</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/honey\" title=\"honey\">honey</a>, supposed to resemble a <a rel=\"mw:WikiLink\" href=\"/wiki/kernel\" title=\"kernel\">kernel</a> of <a rel=\"mw:WikiLink\" href=\"/wiki/maize\" title=\"maize\">maize</a>; typically colored in yellow, orange, and white stripes to represent the colors of the fall harvest; a staple candy of the fall season and <a rel=\"mw:WikiLink\" href=\"/wiki/Halloween\" title=\"Halloween\">Halloween</a> in <a rel=\"mw:WikiLink\" href=\"/wiki/North_America\" title=\"North America\">North America</a>."
        }
      ]
